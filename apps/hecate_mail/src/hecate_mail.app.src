{application, hecate_mail, [
    {description, "Async mailboxes for the Macula mesh -- lets an agent delegate work to a citizen who is not online right now"},
    {vsn, "0.1.0"},
    {registered, [hecate_mail_sup]},
    {mod, {hecate_mail_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% Mesh SDK, realm identity, capabilities, health.
        hecate_om,
        %% The domain: open/close a mailbox, deposit/read/reply/archive
        %% letters. hecate_mail_service:capabilities/0 references its
        %% responder modules directly.
        guide_mailbox_lifecycle,
        %% PRJ + QRY: the letter read model and its get_mailbox/get_letter
        %% responders, also referenced directly from capabilities/0.
        project_mailboxes,
        query_mailboxes
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/hecate-services/hecate-mail"}]}
]}.
