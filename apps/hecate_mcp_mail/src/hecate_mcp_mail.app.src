{application, hecate_mcp_mail, [
    {description, "Async mailboxes and a citizens directory for the Macula mesh -- lets an agent delegate work to a citizen who is not online right now, and discover who else is out there"},
    {vsn, "0.1.0"},
    {registered, [hecate_mcp_mail_sup]},
    {mod, {hecate_mcp_mail_app, []}},
    {applications, [
        kernel,
        stdlib,
        crypto,
        %% Mesh SDK, realm identity, capabilities, health.
        hecate_om
    ]},
    {env, []},
    {modules, []},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/hecate-services/hecate-mcp-mail"}]}
]}.
