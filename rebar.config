%% -*- mode: erlang -*-
%% rebar3 configuration for hecate_mail.
%%
%% Async mailboxes for the Macula mesh -- lets an agent delegate work to a citizen who is not online right now
%%
%% Generated by `rebar3 new hecate_service'. The scaffold boots, joins the mesh
%% and answers /health; it does nothing else yet.

{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    %% The shared L2 substrate: mesh SDK, realm identity, capabilities, health.
    %% Brings macula (QUIC NIF) transitively. The service module exports no
    %% store_id/0 + data_dir/0, so hecate_om wires the mesh and starts NO
    %% reckon-db. Export both callbacks to turn this into a CMD/PRJ service that
    %% owns an event store; hecate_om:boot/1 does the wiring before start/1.
    {hecate_om, "~> 0.13"}
]}.

{project_plugins, [rebar3_lint]}.

%% The org's structural ruleset, matching the sibling services.
{elvis, [
    {rulesets, #{
        hecate_min => [
            {elvis_style, no_deep_nesting, #{level => 2}},
            {elvis_style, no_nested_try_catch, #{}},
            {elvis_style, no_if_expression, #{}}
        ]
    }},
    {config, [
        #{files => ["apps/*/src/**/*.erl"], ruleset => hecate_min}
    ]}
]}.

{eunit_opts, [verbose]}.

{relx, [
    {release, {hecate_mail, "0.1.0"}, [
        %% CMD: open/close mailbox, deposit/read/reply/archive letters
        guide_mailbox_lifecycle,
        %% PRJ: letter lifecycle -> mailboxes read model
        project_mailboxes,
        %% QRY: get_mailbox/get_letter
        query_mailboxes,
        hecate_mail,
        sasl
    ]},
    {sys_config_src, "config/sys.config.src"},
    {vm_args_src,    "config/vm.args.src"},
    {extended_start_script, true}
]}.

{profiles, [
    {prod, [{relx, [{mode, prod},
                    {include_src, false},
                    {include_erts, true},
                    {debug_info, strip}]}]}
]}.
