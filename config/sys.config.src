%% Substituted by relx at boot; every ${VAR} must resolve or the node will not
%% start with a malformed term. That is the correct failure: a service with a
%% half-configured realm announces itself where nobody can attribute it, which
%% looks exactly like a healthy node.
[
    {hecate_om, [
        {service_cert_path, "/etc/hecate/secrets/service-cert.pem"},
        {station_socket,    "/run/macula/station.sock"},
        {health_port,       ${HECATE_HEALTH_PORT}},
        {capability_topic,  <<"_mesh.cap.">>},
        %% MANDATORY BECAUSE THIS SERVICE ADVERTISES CAPABILITIES (see
        %% capabilities/0 in hecate_mail_service.erl). Without this,
        %% hecate_om_identity:keypair/0 returns {error, no_keypair} forever,
        %% and hecate_om_capabilities:advertise_with/7's guard clause
        %% requires {ok, KeyPair} — so it silently no-ops on every republish
        %% tick, permanently, with no crash and no error logged. The service
        %% still connects and calls fine (peering doesn't need a persistent
        %% keypair), so this looks exactly like a healthy node while every
        %% capability is unreachable. Confirmed live 2026-08-30: 5+ hours
        %% uptime, connected => true, capabilities registered in-process, but
        %% every mesh_call against hecate_mail.initiate_mailbox/open_mailbox/
        %% deposit_letter failed with unknown_next_peer the entire time.
        %% Same bug class hecate-tube already hit and fixed — see its
        %% sys.config.src for the identical line this mirrors.
        {identity_key_path, "${HECATE_DATA_DIR}/identity/keypair.erl.bin"},
        %% THE REALM IS AN APPLICATION ENV, NOT A SHELL VARIABLE, and this file
        %% is the only place the two meet. hecate_om_identity:realm() reads
        %% application:get_env(hecate_om, realm); exporting HECATE_REALM in the
        %% shell and expecting that to be enough has cost a sibling service an
        %% hour, because nothing translates between the two by itself.
        {realm,             <<"${HECATE_REALM}">>}
    ]},
    %% ==========================================================================
    %% EVOQ'S ADAPTER, WITHOUT WHICH THIS NODE DOES NOT BOOT
    %% ==========================================================================
    %%
    %% ⚠ MANDATORY BECAUSE THIS SERVICE EXPORTS `store_id/0'. `hecate_om:boot/1'
    %% then starts the store AND a per-store evoq subscription, and that
    %% subscription reads the global log through evoq, which crashes on
    %% `{not_configured, event_store_adapter}' if this block is absent. evoq
    %% starts as a release-boot application before any service's `start/2' runs,
    %% so hecate_om cannot inject it at runtime.
    %%
    %% `hecate_om_store' documents this in its own module header, calling it
    %% MANDATORY, and a sibling service still put two of three fleet nodes into a
    %% boot-crash loop because the callbacks were added without reading it. That
    %% is why this block is generated rather than left to be discovered.
    {evoq, [
        {event_store_adapter,    reckon_evoq_adapter},
        {subscription_adapter,   reckon_evoq_adapter},
        {snapshot_store_adapter, reckon_evoq_adapter},
        %% A fallback evoq resolves before it knows whether anything dispatches a
        %% command. It must name the SAME store as `store_id/0', and a generated
        %% test compares the two.
        {store_id,               hecate_mail_store}
    ]},
    {kernel, [{logger_level, info}]}
].
